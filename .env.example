# ArthaYantra 2.0 — environment template (A.9 / COMMON §10.3)
# Copy to .env (gitignored). Mock mode boots with ZERO secret values present.
# Placeholders only — never commit real values anywhere.

# ---- mode ------------------------------------------------------------------
# mock  = credential-free deterministic feed (CI, dev, onboarding — default)
# live  = real Kite OAuth + WebSocket; services fail fast if secrets absent
SPRING_PROFILES_ACTIVE=mock

# ---- Kite credentials (live mode only; A6: brand-new 2.0 key pair) ---------
# Consumed by market-data-service via Docker secret files in deploy/secrets/
# (this .env never holds real values; see deploy/secrets/README inside repo)
KITE_API_KEY=
KITE_API_SECRET=

# ---- owner auth (edge-gateway) ----------------------------------------------
# Argon2id PHC string (m=19456 KiB, t=2, p=1) — generate with tools/hash-password:
#   .\mvnw.cmd -pl tools/hash-password -q exec:java "-Dexec.args=<password>"
# IMPORTANT: docker compose interpolates $ inside .env values — escape every
# $ in the PHC as $$ when pasting it here ($argon2id... -> $$argon2id...).
ARTHA_OWNER_PASSWORD_HASH=

# ---- crypto ------------------------------------------------------------------
# 256-bit base64 AES-GCM key for the Kite access-token row (Stage B).
# Lives in a Docker secret file in deploy/secrets/, documented here only.
ARTHA_MASTER_KEY=

# ---- database ----------------------------------------------------------------
# The real value lives in deploy/secrets/postgres_password (file-mounted as
# POSTGRES_PASSWORD_FILE — never a plain env var on the container, A.9/T4).
POSTGRES_PASSWORD=

# ---- gateway WS bridge -------------------------------------------------------
# Conflated flush rate for tick topics, Hz (10–20 sane range; 20 = default)
GATEWAY_WS_FLUSH_HZ=20

# ---- Kite client tuning (Stage B consumers) ----------------------------------
KITE_QUOTE_BATCH_SIZE=250

# ---- mock feed knobs (CD-10) --------------------------------------------------
MOCK_TICKS_PER_SEC=1
MOCK_SCENARIO=trend-up   # trend-up | trend-down | chop | gap-open

# ---- OpenAlgo appliance (plan §2/§3; opt-in `ay up openalgo`) ------------------
# In-container service URLs (loopback compose network). The appliance itself is
# configured in deploy/openalgo/.env (generated by `ay`); these only tell
# market-data-service where to reach it when a capture capability is routed to
# OpenAlgo (artha.marketdata.source.*=openalgo, Phase 1). Defaults are fine.
ARTHA_OPENALGO_BASE_URL=http://openalgo:5000
ARTHA_OPENALGO_WS_URL=ws://openalgo:8765

# ---- ops alerts (optional) ----------------------------------------------------
# Signal/scalp-alert push channel (strategy-signal notifier). BLANK = disabled — fail-closed
# (audit P0-6): the mock profile gets the WireMock stub via ay.ps1; live pushes need BOTH set,
# e.g. ARTHA_NOTIFIER_NTFY_URL=https://ntfy.sh plus your private topic.
ARTHA_NOTIFIER_NTFY_URL=
ARTHA_NOTIFIER_NTFY_TOPIC=

# ntfy topic for first-party critical alerts (backup failure + success dead-man,
# contract-canary drift, corporate-action anomalies — reaches db-backup AND market-data).
# Unset = alerting is a no-op.
ARTHA_NTFY_TOPIC=

# F6 Telegram command bot (PR #493) — two-way surface over the PAPER stack (/status /pnl
# /positions + confirm-guarded /pause /resume /flatten). Triple fail-closed: dormant unless
# ALL THREE are set. BOT_TOKEN from BotFather (escape any $ as $$ — compose interpolation);
# CHAT_ID = your numeric id (message the bot once, then @userinfobot). The same token also
# arms the one-way TELEGRAM scalp-alert channel. Flip ENABLED=true last, then `ay up`.
ARTHA_TELEGRAM_COMMANDS_ENABLED=false
ARTHA_NOTIFIER_TELEGRAM_BOT_TOKEN=
ARTHA_NOTIFIER_TELEGRAM_CHAT_ID=

# ---- Minervini SEPA swing strategy (Phase-9; long-only cash-equity paper) ------
# The swing setups are a DAILY EOD BATCH, not a tick strategy — equities don't tick on
# the live feed, so MinerviniSwingEngine runs post-close (~20:00 IST) over the fresh 1d
# bar and reuses the FROZEN Entry/ExitEvaluator (parity-safe). Three independent gates,
# all default-OFF so a stock config stays credential-free:
#   SEED_STRATEGIES  — publish the 4 setups (vcp / primary-base / cheat-3c / power-play)
#                      on boot so the funnel + engine have something to load.
#   SWING_ENABLED    — arm the daily batch (scheduler + POST /run). OFF = total no-op.
#   BUYABLE_ALERTS   — push per-symbol buyable alerts (needs a notifier channel above).
# Go-live = flip SEED + SWING to true, then `ay up` (or recreate strategy-signal). The
# batch fires post-close and auto-papers entries; exits get daily 8%-stop + 50d-MA trail.
ARTHA_MINERVINI_SEED_STRATEGIES=false
ARTHA_MINERVINI_SWING_ENABLED=false
ARTHA_MINERVINI_BUYABLE_ALERTS_ENABLED=false

# ── Ops-tunable knobs (audit M29) ─────────────────────────────────────────────────────
# All OPTIONAL — unset keeps the coded default (shown). Graduation is measurement-only
# (see ARTHA_GRADUATION_PROMOTION_ENABLED), so these move only the readiness board /
# promotion marker, never a live order. Set + recreate strategy-signal to apply.
#ARTHA_GRADUATION_MIN_TRADES=20
#ARTHA_GRADUATION_MIN_PROFIT_FACTOR=1.3
#ARTHA_GRADUATION_MIN_EXPECTANCY=0
#ARTHA_GRADUATION_MAX_DRAWDOWN_PCT=25
#ARTHA_GRADUATION_BASE_CAPITAL=100000
#ARTHA_GRADUATION_PROMOTION_MIN_TRADES=50
#ARTHA_GRADUATION_PROMOTION_MIN_SHARPE=0.5
#ARTHA_GRADUATION_PROMOTION_MIN_EXPECTANCY=0
#ARTHA_GRADUATION_PROMOTION_MAX_DRAWDOWN_PCT=25
#ARTHA_PAPER_RISK_PER_TRADE_RISK_PCT=1.0
# Manual paper-take signal-freshness gate (minutes): a signal-linked POST /api/v1/paper/orders whose
# SIGNAL is older than this on a NON-swing book 422s SIGNAL_STALE. Swing books (minervini/manas-arora)
# are exempt; 0 disables. Default 60.
#ARTHA_PAPER_SIGNAL_TAKE_MAX_AGE_MINUTES=60
# Batch/evaluator crons (Asia/Kolkata):
#ARTHA_GRADUATION_PROMOTION_CRON=0 0 21 * * MON-FRI
#ARTHA_MINERVINI_SWING_CRON=0 0 20 * * MON-FRI
#ARTHA_MANAS_ARORA_SWING_CRON=0 5 20 * * MON-FRI
#ARTHA_SWING_CANARY_CRON=0 30 8 * * MON-FRI

# External dead-man's-switch for the swing batches — the ONE outage the in-stack canaries can't
# catch (a whole-stack/host DOWN at batch time; root cause of the 2026-07-09 silently-missed batch).
# Blank = dormant. To arm: create a healthchecks.io (or UptimeRobot "heartbeat") check, set its
# expected schedule to `15 20 * * 1-5` TZ Asia/Kolkata with a grace window, paste its ping URL here,
# and redeploy strategy-signal. The stack pings it at 20:15 IST after both swing batches; if the stack
# is down the ping is absent and the EXTERNAL monitor alerts you (off-box, survives the outage).
#ARTHA_HEARTBEAT_URL=
#ARTHA_HEARTBEAT_SWING_CRON=0 15 20 * * MON-FRI
