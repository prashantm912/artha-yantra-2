# ArthaYantra 2.0 — environment template (A.9 / COMMON §10.3)
# Copy to .env (gitignored). Mock mode boots with ZERO secret values present.
# Placeholders only — never commit real values anywhere.

# ---- mode ------------------------------------------------------------------
# mock  = credential-free deterministic feed (CI, dev, onboarding — default)
# live  = real Kite OAuth + WebSocket; services fail fast if secrets absent
SPRING_PROFILES_ACTIVE=mock

# ---- Kite credentials (live mode only; A6: brand-new 2.0 key pair) ---------
# Consumed by market-data-service via Docker secret files in deploy/secrets/
# (this .env never holds real values; see deploy/secrets/README inside repo)
KITE_API_KEY=
KITE_API_SECRET=

# ---- owner auth (edge-gateway) ----------------------------------------------
# Argon2id PHC string (m=19456 KiB, t=2, p=1) — generate with tools/hash-password:
#   .\mvnw.cmd -pl tools/hash-password -q exec:java "-Dexec.args=<password>"
# IMPORTANT: docker compose interpolates $ inside .env values — escape every
# $ in the PHC as $$ when pasting it here ($argon2id... -> $$argon2id...).
ARTHA_OWNER_PASSWORD_HASH=

# ---- crypto ------------------------------------------------------------------
# 256-bit base64 AES-GCM key for the Kite access-token row (Stage B).
# Lives in a Docker secret file in deploy/secrets/, documented here only.
ARTHA_MASTER_KEY=

# ---- database ----------------------------------------------------------------
# The real value lives in deploy/secrets/postgres_password (file-mounted as
# POSTGRES_PASSWORD_FILE — never a plain env var on the container, A.9/T4).
POSTGRES_PASSWORD=

# ---- gateway WS bridge -------------------------------------------------------
# Conflated flush rate for tick topics, Hz (10–20 sane range; 20 = default)
GATEWAY_WS_FLUSH_HZ=20

# ---- Kite client tuning (Stage B consumers) ----------------------------------
KITE_QUOTE_BATCH_SIZE=250

# ---- mock feed knobs (CD-10) --------------------------------------------------
MOCK_TICKS_PER_SEC=1
MOCK_SCENARIO=trend-up   # trend-up | trend-down | chop | gap-open

# ---- OpenAlgo appliance (plan §2/§3; opt-in `ay up openalgo`) ------------------
# In-container service URLs (loopback compose network). The appliance itself is
# configured in deploy/openalgo/.env (generated by `ay`); these only tell
# market-data-service where to reach it when a capture capability is routed to
# OpenAlgo (artha.marketdata.source.*=openalgo, Phase 1). Defaults are fine.
ARTHA_OPENALGO_BASE_URL=http://openalgo:5000
ARTHA_OPENALGO_WS_URL=ws://openalgo:8765

# ---- ops alerts (optional) ----------------------------------------------------
# Signal/scalp-alert push channel (strategy-signal notifier). BLANK = disabled — fail-closed
# (audit P0-6): the mock profile gets the WireMock stub via ay.ps1; live pushes need BOTH set,
# e.g. ARTHA_NOTIFIER_NTFY_URL=https://ntfy.sh plus your private topic.
ARTHA_NOTIFIER_NTFY_URL=
ARTHA_NOTIFIER_NTFY_TOPIC=

# ntfy topic for first-party critical alerts (backup failure + success dead-man,
# contract-canary drift, corporate-action anomalies — reaches db-backup AND market-data).
# Unset = alerting is a no-op.
ARTHA_NTFY_TOPIC=

# F6 Telegram command bot (PR #493) — two-way surface over the PAPER stack (/status /pnl
# /positions + confirm-guarded /pause /resume /flatten). Triple fail-closed: dormant unless
# ALL THREE are set. BOT_TOKEN from BotFather (escape any $ as $$ — compose interpolation);
# CHAT_ID = your numeric id (message the bot once, then @userinfobot). The same token also
# arms the one-way TELEGRAM scalp-alert channel. Flip ENABLED=true last, then `ay up`.
ARTHA_TELEGRAM_COMMANDS_ENABLED=false
ARTHA_NOTIFIER_TELEGRAM_BOT_TOKEN=
ARTHA_NOTIFIER_TELEGRAM_CHAT_ID=
