# ArthaYantra 2.0 — environment template (A.9 / COMMON §10.3)
# Copy to .env (gitignored). Mock mode boots with ZERO secret values present.
# Placeholders only — never commit real values anywhere.

# ---- mode ------------------------------------------------------------------
# mock  = credential-free deterministic feed (CI, dev, onboarding — default)
# live  = real Kite OAuth + WebSocket; services fail fast if secrets absent
SPRING_PROFILES_ACTIVE=mock

# ---- Kite credentials (live mode only; A6: brand-new 2.0 key pair) ---------
# Consumed by market-data-service via Docker secret files in deploy/secrets/
# (this .env never holds real values; see deploy/secrets/README inside repo)
KITE_API_KEY=
KITE_API_SECRET=

# ---- owner auth (edge-gateway) ----------------------------------------------
# Argon2id PHC string (m=19456 KiB, t=2, p=1) — generate with tools/hash-password
ARTHA_OWNER_PASSWORD_HASH=

# ---- crypto ------------------------------------------------------------------
# 256-bit base64 AES-GCM key for the Kite access-token row (Stage B).
# Lives in a Docker secret file in deploy/secrets/, documented here only.
ARTHA_MASTER_KEY=

# ---- database ----------------------------------------------------------------
# The real value lives in deploy/secrets/postgres_password (file-mounted as
# POSTGRES_PASSWORD_FILE — never a plain env var on the container, A.9/T4).
POSTGRES_PASSWORD=

# ---- gateway WS bridge -------------------------------------------------------
# Conflated flush rate for tick topics, Hz (10–20 sane range; 20 = default)
GATEWAY_WS_FLUSH_HZ=20

# ---- Kite client tuning (Stage B consumers) ----------------------------------
KITE_QUOTE_BATCH_SIZE=250

# ---- mock feed knobs (CD-10) --------------------------------------------------
MOCK_TICKS_PER_SEC=1
MOCK_SCENARIO=trend-up   # trend-up | trend-down | chop | gap-open

# ---- ops alerts (optional) ----------------------------------------------------
# ntfy topic for first-party critical alerts (backup failure etc.).
# Unset = alerting is a no-op.
ARTHA_NTFY_TOPIC=
