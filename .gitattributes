# Normalize line endings in the repo; working-tree per type below.
* text=auto

# Shell scripts run inside Linux containers (compose entrypoints, ay.sh,
# backup.sh, flyway-run.sh) — must always be LF, even on Windows checkouts.
*.sh text eol=lf
ay.sh text eol=lf
mvnw text eol=lf

# Windows scripts stay CRLF.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# SQL migrations are checksummed by Flyway — keep them byte-stable as LF.
*.sql text eol=lf

# Codex skill prompt templates — substituted by the harness scripts and sent
# to Codex; keep LF so no stray CR leaks into the prompt on Windows checkouts.
*.tpl text eol=lf

# JSON (schema files, OpenAPI contracts, fixtures) — byte-stable as LF so the
# Maven JAR resource and the on-disk file are identical on all platforms.
*.json text eol=lf

# Hash-locked Python deps — COPYed into Linux images + installed under
# --require-hashes; keep LF so the file is byte-stable on all platforms.
*.lock text eol=lf

# Binary
*.png binary
*.jpg binary
*.jar binary
