# Normalize line endings in the repo; working-tree per type below.
* text=auto

# Shell scripts run inside Linux containers (compose entrypoints, ay.sh,
# backup.sh, flyway-run.sh) — must always be LF, even on Windows checkouts.
*.sh text eol=lf
ay.sh text eol=lf
mvnw text eol=lf

# Windows scripts stay CRLF.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# SQL migrations are checksummed by Flyway — keep them byte-stable as LF.
*.sql text eol=lf

# Binary
*.png binary
*.jpg binary
*.jar binary
