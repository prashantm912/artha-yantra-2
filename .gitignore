# --- secrets & local config (never committed — A.9 / ADR D13) ---
.env
.env.*
!.env.example
# OpenAlgo appliance config: commit the sample + README, ignore the generated .env
# (.env above already ignores deploy/openalgo/.env; .env.* would hide the sample — re-include it)
!deploy/openalgo/.env.sample
deploy/secrets/*
!deploy/secrets/.gitkeep
!deploy/secrets/README.md
# Machine-specific CA certs for TLS-intercepting AV (e.g. Avast Web/Mail Shield).
# Generated once per dev box by a setup script; CI/prod dirs stay empty.
deploy/dev-certs/*.pem
deploy/dev-certs/*.cer
**/application-local*.properties
**/application-local*.yml

# --- backups (nightly pg_dump bind mount — A.11) ---
backups/

# --- SPAN risk files (§8): daily, host-fetched, mounted read-only into
# margin-service. NEVER committed (they change every trading day). Keep the
# bind-mount dir + its README; ignore the .spn/.zip payloads. ---
deploy/span-files/*
!deploy/span-files/.gitkeep
!deploy/span-files/README.md

# --- build output ---
target/
dist/
build/
*.class

# --- node ---
node_modules/
npm-debug.log*

# --- python ---
.venv/
__pycache__/
*.pyc

# --- IDE / OS ---
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db

# --- logs & JVM crash dumps ---
*.log
hs_err_pid*
replay_pid*

# --- oipulse study auth state (saved Playwright cookies) ---
docs/oipulse-study/.oipulse-state.json

# --- oipulse raw source manual (20 MB PDF — local archive only; the derived .md study docs ARE versioned) ---
docs/oipulse-study/Oi-Pulse-Manual-file.pdf

# --- MCP tool working directories (ephemeral; findings encoded in docs) ---
.playwright-mcp/
.firecrawl/

# --- session screenshots / one-off captures at repo root ---
*.png
oipulse-frame.html
/tools/historical-import/manifest_live.sqlite
/tools/historical-import/run_full_load.ps1
# OpenAlgo OI parity reports (generated by the Monday scheduled task)
/tools/openalgo/reports/

# --- Siva strategy raw decks (173 MB of PDFs — local archive only) ---
# The 3 .md docs in strategy-documents/options-scalper-siva/ ARE versioned (the parity
# spec the engine ports from); the raw PDF backup stays on disk, never in git history.
strategy-documents/options-scalper-siva/original-source-backup/
