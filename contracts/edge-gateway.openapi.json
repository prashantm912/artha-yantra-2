{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "edge-gateway",
    "description" : "Sole ingress (Stage A): owner auth, sessions, WS bridge, routing",
    "version" : "v1"
  },
  "paths" : {
    "/api/v1/auth/logout" : {
      "post" : {
        "tags" : [ "auth-controller" ],
        "operationId" : "logout",
        "responses" : {
          "200" : {
            "description" : "OK"
          },
          "default" : {
            "description" : "Error envelope (COMMON 8.3)",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login" : {
      "post" : {
        "tags" : [ "auth-controller" ],
        "operationId" : "login",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "object"
                }
              }
            }
          },
          "default" : {
            "description" : "Error envelope (COMMON 8.3)",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/system/status" : {
      "get" : {
        "tags" : [ "system-status-controller" ],
        "operationId" : "status",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SystemStatus"
                }
              }
            }
          },
          "default" : {
            "description" : "Error envelope (COMMON 8.3)",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/session" : {
      "get" : {
        "tags" : [ "auth-controller" ],
        "operationId" : "session",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SessionState"
                }
              }
            }
          },
          "default" : {
            "description" : "Error envelope (COMMON 8.3)",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components" : {
    "schemas" : {
      "KiteStatus" : {
        "type" : "object",
        "properties" : {
          "session" : {
            "type" : "string"
          },
          "raw" : {
            "type" : [ "string", "null" ]
          },
          "ticker" : {
            "type" : "string"
          },
          "lastTickAgeMs" : {
            "type" : [ "integer", "null" ],
            "format" : "int64"
          },
          "rateBudget" : {
            "type" : [ "number", "null" ],
            "format" : "double"
          }
        },
        "required" : [ "lastTickAgeMs", "rateBudget", "raw", "session", "ticker" ]
      },
      "MarketStatus" : {
        "type" : "object",
        "properties" : {
          "phase" : {
            "type" : "string"
          }
        },
        "required" : [ "phase" ]
      },
      "ServiceStatus" : {
        "type" : "object",
        "properties" : {
          "name" : {
            "type" : "string"
          },
          "status" : {
            "type" : "string"
          }
        },
        "required" : [ "name", "status" ]
      },
      "SystemStatus" : {
        "type" : "object",
        "properties" : {
          "overall" : {
            "type" : "string"
          },
          "status" : {
            "type" : "string"
          },
          "services" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/ServiceStatus"
            }
          },
          "kite" : {
            "$ref" : "#/components/schemas/KiteStatus"
          },
          "market" : {
            "$ref" : "#/components/schemas/MarketStatus"
          },
          "corporateActions" : {
            "type" : "string"
          },
          "jobs" : {
            "type" : "object",
            "additionalProperties" : { }
          },
          "asOf" : {
            "type" : "string"
          }
        },
        "required" : [ "asOf", "corporateActions", "jobs", "kite", "market", "overall", "services", "status" ]
      },
      "SessionState" : {
        "type" : "object",
        "properties" : {
          "authenticated" : {
            "type" : "boolean"
          },
          "loginTime" : {
            "type" : [ "string", "null" ]
          },
          "profile" : {
            "type" : "string"
          }
        },
        "required" : [ "authenticated", "loginTime", "profile" ]
      },
      "ErrorResponse" : {
        "type" : "object",
        "properties" : {
          "code" : {
            "type" : "string"
          },
          "message" : {
            "type" : "string"
          },
          "details" : {
            "type" : "object"
          }
        }
      }
    }
  }
}
