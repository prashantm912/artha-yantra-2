{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "edge-gateway",
    "description" : "Sole ingress (Stage A): owner auth, sessions, WS bridge, routing",
    "version" : "v1"
  },
  "paths" : {
    "/api/v1/auth/logout" : {
      "post" : {
        "tags" : [ "auth-controller" ],
        "operationId" : "logout",
        "parameters" : [ {
          "name" : "session",
          "in" : "query",
          "required" : true,
          "schema" : {
            "$ref" : "#/components/schemas/WebSession"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK"
          },
          "default" : {
            "description" : "Error envelope (COMMON 8.3)",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login" : {
      "post" : {
        "tags" : [ "auth-controller" ],
        "operationId" : "login",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "object"
                }
              }
            }
          },
          "default" : {
            "description" : "Error envelope (COMMON 8.3)",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/system/status" : {
      "get" : {
        "tags" : [ "system-status-controller" ],
