{
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LegIn": {
        "description": "One option/future leg for the ``/margin/size`` sizing endpoint.",
        "properties": {
          "expiry": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expiry"
          },
          "lotSize": {
            "title": "Lotsize",
            "type": "integer"
          },
          "optionType": {
            "title": "Optiontype",
            "type": "string"
          },
          "side": {
            "enum": [
              "BUY",
              "SELL"
            ],
            "title": "Side",
            "type": "string"
          },
          "strike": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Strike"
          },
          "symbol": {
            "title": "Symbol",
            "type": "string"
          }
        },
        "required": [
          "symbol",
          "optionType",
          "side",
          "lotSize"
        ],
        "title": "LegIn",
        "type": "object"
      },
      "MarginRequest": {
        "properties": {
          "positions": {
            "items": {
              "$ref": "#/components/schemas/PositionIn"
            },
            "title": "Positions",
            "type": "array"
          }
        },
        "required": [
          "positions"
        ],
        "title": "MarginRequest",
        "type": "object"
      },
      "MarginResponse": {
        "properties": {
          "currency": {
            "default": "INR",
            "title": "Currency",
            "type": "string"
          },
          "exposure": {
            "title": "Exposure",
            "type": "string"
          },
          "hedgeBenefit": {
            "title": "Hedgebenefit",
            "type": "string"
          },
          "span": {
            "title": "Span",
            "type": "string"
          },
          "spnDate": {
            "title": "Spndate",
            "type": "string"
          },
          "total": {
            "title": "Total",
            "type": "string"
          }
        },
        "required": [
          "span",
          "exposure",
          "total",
          "hedgeBenefit",
          "spnDate"
        ],
        "title": "MarginResponse",
        "type": "object"
      },
      "PositionIn": {
        "description": "One basket leg for the raw ``/margin`` endpoint.",
        "properties": {
          "expiry": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expiry"
          },
          "netQty": {
            "title": "Netqty",
            "type": "integer"
          },
          "optionType": {
            "title": "Optiontype",
            "type": "string"
          },
          "strike": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Strike"
          },
          "symbol": {
            "title": "Symbol",
            "type": "string"
          }
        },
        "required": [
          "symbol",
          "optionType",
          "netQty"
        ],
        "title": "PositionIn",
        "type": "object"
      },
      "SizeRequest": {
        "properties": {
          "capital": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ],
            "title": "Capital"
          },
          "dailyLossCap": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ],
            "title": "Dailylosscap"
          },
          "dailyLossUsed": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ],
            "default": "0",
            "title": "Dailylossused"
          },
          "entry": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ],
            "title": "Entry"
          },
          "legs": {
            "items": {
              "$ref": "#/components/schemas/LegIn"
            },
            "title": "Legs",
            "type": "array"
          },
          "maxCapitalPct": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ],
            "default": "0.20",
            "title": "Maxcapitalpct"
          },
          "rrTarget": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ],
            "default": "2.0",
            "title": "Rrtarget"
          },
          "stop": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stop"
          }
        },
        "required": [
          "capital",
          "dailyLossCap",
          "entry",
          "legs"
        ],
        "title": "SizeRequest",
        "type": "object"
      },
      "SizeResponse": {
        "properties": {
          "capitalUsed": {
            "title": "Capitalused",
            "type": "string"
          },
          "limitingRail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Limitingrail"
          },
          "lots": {
            "title": "Lots",
            "type": "integer"
          },
          "marginRequired": {
            "title": "Marginrequired",
            "type": "string"
          },
          "qty": {
            "title": "Qty",
            "type": "integer"
          },
          "riskAmount": {
            "title": "Riskamount",
            "type": "string"
          },
          "target": {
            "title": "Target",
            "type": "string"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "title": "Warnings",
            "type": "array"
          },
          "withinRails": {
            "title": "Withinrails",
            "type": "boolean"
          }
        },
        "required": [
          "lots",
          "qty",
          "marginRequired",
          "capitalUsed",
          "riskAmount",
          "target",
          "withinRails",
          "warnings",
          "limitingRail"
        ],
        "title": "SizeResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "margin-service",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/margin": {
      "post": {
        "description": "Raw SPAN (span/exposure/total/hedgeBenefit) for a basket; 503 if no .spn loaded.",
        "operationId": "margin_api_v1_margin_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MarginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MarginResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Margin"
      }
    },
    "/api/v1/margin/size": {
      "post": {
        "description": "Rail-bounded lots/qty + margin + RR target for an order; never blocks (advisory).",
        "operationId": "size_api_v1_margin_size_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SizeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SizeResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Size"
      }
    },
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/metrics": {
      "get": {
        "description": "Endpoint that serves Prometheus metrics.",
        "operationId": "metrics_metrics_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Metrics"
      }
    }
  }
}
