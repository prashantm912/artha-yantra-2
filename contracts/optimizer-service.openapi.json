  "info": {
    "title": "optimizer-service",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/optimizations/jobs/{job_id}": {
      "delete": {
        "description": "Cancel a sweep (queued trials dropped; running finish at a checkpoint).",
        "operationId": "cancel_api_v1_optimizations_jobs__job_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "title": "Job Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Cancel Api V1 Optimizations Jobs  Job Id  Delete",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Cancel"
      },
      "get": {
        "description": "Sweep status / progress / trials completed.",
        "operationId": "job_api_v1_optimizations_jobs__job_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "title": "Job Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Job Api V1 Optimizations Jobs  Job Id  Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Job"
      }
    },
    "/api/v1/optimizations/run": {
      "post": {
        "description": "Submit a sweep \u2192 202 {jobId, status:\"queued\"}.",
        "operationId": "run_api_v1_optimizations_run_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": true,
                "title": "Body",
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Run Api V1 Optimizations Run Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Run"
      }
    },
    "/api/v1/optimizations/{sweep_id}/best": {
      "get": {
        "description": "Top-N leaderboard; default sort is plateau-adjusted, ``sort=raw`` for raw objective.",
        "operationId": "best_api_v1_optimizations__sweep_id__best_get",
        "parameters": [
          {
            "in": "path",
            "name": "sweep_id",
            "required": true,
            "schema": {
              "title": "Sweep Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "top",
            "required": false,
            "schema": {
              "default": 10,
              "title": "Top",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "sort",
            "required": false,
            "schema": {
              "default": "plateau",
              "title": "Sort",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Best Api V1 Optimizations  Sweep Id  Best Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Best"
      }
    },
    "/api/v1/optimizations/{sweep_id}/promote": {
      "post": {
        "description": "Promote a COMPLETE trial's params to a new draft version (\u00a7D.9); 409 if not promotable.",
        "operationId": "promote_api_v1_optimizations__sweep_id__promote_post",
        "parameters": [
          {
            "in": "path",
            "name": "sweep_id",
            "required": true,
            "schema": {
              "title": "Sweep Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": true,
                "title": "Body",
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Promote Api V1 Optimizations  Sweep Id  Promote Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Promote"
      }
    },
    "/api/v1/optimizations/{sweep_id}/trials": {
      "get": {
        "description": "Paged trial leaderboard rows for a sweep.",
        "operationId": "trials_api_v1_optimizations__sweep_id__trials_get",
        "parameters": [
          {
            "in": "path",
            "name": "sweep_id",
            "required": true,
            "schema": {
              "title": "Sweep Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "state",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "State"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 100,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "title": "Offset",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Trials Api V1 Optimizations  Sweep Id  Trials Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Trials"
      }
    },
    "/api/v1/optimizations/{sweep_id}/trials/{trial_id}/folds": {
      "get": {
        "description": "The per-fold metric array for one trial (resolved via its ``backtest_run_id``).",
        "operationId": "trial_folds_api_v1_optimizations__sweep_id__trials__trial_id__folds_get",
        "parameters": [
          {
            "in": "path",
            "name": "sweep_id",
            "required": true,
            "schema": {
              "title": "Sweep Id",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "trial_id",
            "required": true,
            "schema": {
              "title": "Trial Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "title": "Response Trial Folds Api V1 Optimizations  Sweep Id  Trials  Trial Id  Folds Get"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Trial Folds"
      }
    },
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/metrics": {
      "get": {
        "description": "Endpoint that serves Prometheus metrics.",
        "operationId": "metrics_metrics_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Metrics"
      }
    }
  }
}
