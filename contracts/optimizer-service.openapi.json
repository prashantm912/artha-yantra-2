{
  "openapi": "3.1.0",
  "info": {
    "title": "optimizer-service",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/optimizations/run": {
      "post": {
        "summary": "Run",
        "description": "Submit a sweep \u2192 202 {jobId, status:\"queued\"}.",
        "operationId": "run_api_v1_optimizations_run_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": true,
                "type": "object",
                "title": "Body"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Run Api V1 Optimizations Run Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/optimizations/jobs/{job_id}": {
      "get": {
        "summary": "Job",
        "description": "Sweep status / progress / trials completed.",
        "operationId": "job_api_v1_optimizations_jobs__job_id__get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Job Api V1 Optimizations Jobs  Job Id  Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Cancel",
        "description": "Cancel a sweep (queued trials dropped; running finish at a checkpoint).",
        "operationId": "cancel_api_v1_optimizations_jobs__job_id__delete",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Cancel Api V1 Optimizations Jobs  Job Id  Delete"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/optimizations/{sweep_id}/trials": {
      "get": {
        "summary": "Trials",
        "description": "Paged trial leaderboard rows for a sweep.",
        "operationId": "trials_api_v1_optimizations__sweep_id__trials_get",
        "parameters": [
          {
            "name": "sweep_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Sweep Id"
            }
          },
          {
            "name": "state",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "State"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 100,
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 0,
              "title": "Offset"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Trials Api V1 Optimizations  Sweep Id  Trials Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/optimizations/{sweep_id}/best": {
      "get": {
        "summary": "Best",
        "description": "Top-N leaderboard; default sort is plateau-adjusted, ``sort=raw`` for raw objective.",
        "operationId": "best_api_v1_optimizations__sweep_id__best_get",
        "parameters": [
          {
            "name": "sweep_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Sweep Id"
            }
          },
          {
            "name": "top",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 10,
              "title": "Top"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "plateau",
              "title": "Sort"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Best Api V1 Optimizations  Sweep Id  Best Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/optimizations/{sweep_id}/trials/{trial_id}/folds": {
      "get": {
        "summary": "Trial Folds",
        "description": "The per-fold metric array for one trial (resolved via its ``backtest_run_id``).",
        "operationId": "trial_folds_api_v1_optimizations__sweep_id__trials__trial_id__folds_get",
        "parameters": [
          {
            "name": "sweep_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Sweep Id"
            }
          },
          {
            "name": "trial_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Trial Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "title": "Response Trial Folds Api V1 Optimizations  Sweep Id  Trials  Trial Id  Folds Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/optimizations/{sweep_id}/promote": {
      "post": {
        "summary": "Promote",
        "description": "Promote a COMPLETE trial's params to a new draft version (\u00a7D.9); 409 if not promotable.",
        "operationId": "promote_api_v1_optimizations__sweep_id__promote_post",
        "parameters": [
          {
            "name": "sweep_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Sweep Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true,
                "title": "Body"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Promote Api V1 Optimizations  Sweep Id  Promote Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
