# OpenAlgo appliance config (plan §2). `ay up` copies this to deploy/openalgo/.env (gitignored)
# and fills APP_KEY + API_KEY_PEPPER with generated random values. These lines are injected as
# environment variables; OpenAlgo's start.sh generates its in-container /app/.env from them on boot
# (HOST_SERVER is the generation trigger). Broker login is a RUNTIME step in the OpenAlgo web UI at
# http://127.0.0.1:5001 (the openalgo-publish loopback forwarder) — leave broker creds blank here.
# Format is compose env_file: KEY=value (no quotes, no spaces around =).

# Config-schema version — MUST match the pinned image's /app/.sample.env "Version:" header
# (digest in deploy/docker-compose.yml). OpenAlgo's start.sh defaults this to an OLD 1.0.4 when
# unset, and the app then HARD-REFUSES to boot (interactive "Continue anyway? (y/N)" prompt with no
# TTY → worker exits → :5000 never binds → healthcheck times out). On a digest bump, re-read the
# image's .sample.env version (`docker run --rm <digest> head /app/.sample.env`) and update this.
ENV_CONFIG_VERSION=1.0.7

# Web-UI base + start.sh env-driven generation trigger
HOST_SERVER=http://127.0.0.1:5000

# Flask + WebSocket bind/ports (published on loopback only via the openalgo-publish socat sidecar)
FLASK_HOST_IP=0.0.0.0
FLASK_PORT=5000
FLASK_ENV=production
FLASK_DEBUG=False
WEBSOCKET_HOST=0.0.0.0
WEBSOCKET_PORT=8765
WEBSOCKET_URL=ws://127.0.0.1:8765

# Security keys — GENERATED per box by `ay` (never commit real values). Placeholders below.
APP_KEY=REPLACE_ME_GENERATED_BY_AY
API_KEY_PEPPER=REPLACE_ME_GENERATED_BY_AY

# SQLite/DuckDB under /app/db (persisted by the openalgo-data volume)
DATABASE_URL=sqlite:///db/openalgo.db
SANDBOX_DATABASE_URL=sqlite:///db/sandbox.db

# Broker — left BLANK; choose + log in through the OpenAlgo UI (http://127.0.0.1:5001). Set
# REDIRECT_URL to the loopback publisher (:5001) for the chosen broker, e.g. .../zerodha/callback.
BROKER_API_KEY=
BROKER_API_SECRET=
REDIRECT_URL=http://127.0.0.1:5001/zerodha/callback
NGROK_ALLOW=FALSE
