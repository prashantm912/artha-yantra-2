{
  "name": "frontend-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "eslint src && stylelint \"src/**/*.scss\"",
    "gen:api": "openapi-typescript ../contracts/strategy-signal-service.openapi.json -o ../contracts/gen/strategy-signal-service.d.ts && openapi-typescript ../contracts/market-data-service.openapi.json -o ../contracts/gen/market-data-service.d.ts && openapi-typescript ../contracts/edge-gateway.openapi.json -o ../contracts/gen/edge-gateway.d.ts && openapi-typescript ../contracts/backtest-service.openapi.json -o ../contracts/gen/backtest-service.d.ts && openapi-typescript ../contracts/optimizer-service.openapi.json -o ../contracts/gen/optimizer-service.d.ts",
    "test:ci": "ng test --watch=false"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/animations": "^21.2.17",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@ngrx/signals": "^21.1.1",
    "@primeuix/themes": "^2.0.3",
    "@stomp/stompjs": "^7.3.0",
    "lightweight-charts": ">=5.2 <6",
    "monaco-editor": "^0.55.1",
    "monaco-yaml": "^5.5.1",
    "primeicons": "^7.0.0",
    "primeng": "^21.1.9",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.0",
    "@angular/cli": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "angular-eslint": "^21.4.0",
    "eslint": "^9.39.4",
    "jsdom": "^28.0.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.8.1",
    "stylelint": "^16.26.1",
    "stylelint-config-standard-scss": "^15.0.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.0.8"
  }
}
