<?xml version="1.0" encoding="UTF-8"?>
<!-- libs/black76-math (Stage D Phase 30A / ADR A10): the pure, dependency-free
     Black-76 pricing + IV math, hoisted out of market-data-service's Phase-14
     Greeks engine so live Greeks and the backtest synthetic-premium replay are
     ONE implementation, no drift. Consumed by market-data-service (behavior
     unchanged, proven by the committed py_vollib goldens) and backtest-service. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>in.arthayantra</groupId>
    <artifactId>arthayantra-parent</artifactId>
    <version>2.0.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>black76-math</artifactId>
  <name>black76-math</name>

  <properties>
    <commons-math3.version>3.6.1</commons-math3.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-math3</artifactId>
      <version>${commons-math3.version}</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
