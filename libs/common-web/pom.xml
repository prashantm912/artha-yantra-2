<?xml version="1.0" encoding="UTF-8"?>
<!-- common-web (A.3 / ADR D8): split so the reactive gateway can depend on
     `core` without spring-webmvc on its classpath; servlet services add the
     `servlet` adapter. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>in.arthayantra</groupId>
    <artifactId>arthayantra-parent</artifactId>
    <version>2.0.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>common-web</artifactId>
  <packaging>pom</packaging>
  <name>common-web — aggregator</name>

  <modules>
    <module>core</module>
    <module>servlet</module>
  </modules>
</project>
