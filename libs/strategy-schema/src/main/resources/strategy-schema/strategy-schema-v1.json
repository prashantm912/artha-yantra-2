{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arthayantra.in/schemas/strategy-schema/v1",
  "title": "strategy-schema/v1",
  "description": "ArthaYantra 2.0 versioned strategy document (ADR D18; freezes at the Stage-C exit gate). Includes the freeze-time obligation keys (slippage_bps, fees{}, objective.fold_aggregation, walk_forward, scoring.{optional_min_score, optional_gate_margin}) and the A7 owner-selection keys ratified 2026-06-12 (1w timeframe, risk.session.{pre_close_at, fill_timing, exit_intrabar}, indicator-level instrument override, universe.mode futures_of_underlying + futures{}). The indicator-name enum is ADVISORY (Q2/A5) - names validate against the identifier pattern; existence is a server-side registry check at save/publish, never a schema violation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "name", "version", "universe", "timeframes", "indicators", "entry_rules", "exit_rules", "risk"],
  "properties": {
    "schema": { "const": "strategy-schema/v1" },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$",
      "description": "Stable slug; never changes across versions"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "description": "Semver; bumped automatically on save-as-draft"
    },
    "description": { "type": "string", "maxLength": 2000 },
    "author": { "type": "string", "maxLength": 120 },
    "tags": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
      "uniqueItems": true,
      "maxItems": 24
    },
    "enabled": { "type": "boolean", "default": true },
    "universe": { "$ref": "#/$defs/universe" },
    "timeframes": { "$ref": "#/$defs/timeframes" },
    "indicators": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/indicator" }
    },
    "entry_rules": { "$ref": "#/$defs/entryRules" },
    "exit_rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/exitRule" }
    },
    "risk": { "$ref": "#/$defs/risk" },
    "backtest": { "$ref": "#/$defs/backtest" },
    "scalper": { "$ref": "#/$defs/scalper" }
  },

  "$defs": {
    "interval": {
      "description": "Bar-interval vocabulary; 1w added at the freeze (A7 [FP-8]) - served from the candles_1w aggregate, never fetched; 3m added for the Siva scalper execution timeframe (served from the candles_3m aggregate)",
      "enum": ["1m", "3m", "5m", "15m", "1h", "1d", "1w"]
    },
    "identifier": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "hhmm": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
    "instrumentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exchange", "tradingsymbol"],
      "properties": {
        "exchange": { "type": "string", "minLength": 1, "maxLength": 16 },
        "tradingsymbol": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },

    "universe": {
      "description": "One closed branch per mode; futures{} is valid ONLY under futures_of_underlying (A11 [FP-11a])",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "instruments"],
          "properties": {
            "mode": { "const": "explicit" },
            "instruments": {
              "type": "array",
              "minItems": 1,
              "maxItems": 200,
              "items": { "$ref": "#/$defs/instrumentRef" }
            },
            "filters": { "$ref": "#/$defs/universeFilters" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "index"],
          "properties": {
            "mode": { "const": "index_constituents" },
            "index": { "type": "string", "minLength": 1, "maxLength": 64 },
            "filters": { "$ref": "#/$defs/universeFilters" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "underlying", "options"],
          "properties": {
            "mode": { "const": "options_of_underlying" },
            "underlying": { "$ref": "#/$defs/instrumentRef" },
            "signal_underlying": {
              "$ref": "#/$defs/instrumentRef",
              "description": "Optional: the instrument the SIGNAL/indicators run on, decoupled from the options-execution root in `underlying` (2b-E2). Defaults to `underlying` when absent. Used for e.g. signal on the NIFTY continuous front-future while executing SENSEX option legs (correlation play)."
            },
            "strike_reference": {
              "$ref": "#/$defs/instrumentRef",
              "description": "Optional (2b-E2b): the spot series the ATM strike is anchored on, decoupled from the signal. Defaults to the signal series when absent (so existing configs are byte-identical). Used when the signal is on one index but the options are on another (e.g. signal NIFTY-FUT-CONT, options SENSEX → strike_reference NFO/SENSEX-FUT-CONT, so the SENSEX strike is picked from the SENSEX price, not the NIFTY-future price)."
            },
            "options": {
              "type": "object",
              "additionalProperties": false,
              "required": ["expiry", "strikes"],
              "properties": {
                "expiry": {
                  "oneOf": [
                    { "enum": ["nearest_weekly", "nearest_monthly"] },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["offset"],
                      "properties": { "offset": { "type": "integer", "minimum": 0, "maximum": 12 } }
                    }
                  ]
                },
                "strikes": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["selector"],
                      "properties": { "selector": { "const": "atm" } }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["selector", "width"],
                      "properties": {
                        "selector": { "const": "atm_window" },
                        "width": { "type": "integer", "minimum": 0, "maximum": 10 }
                      }
                    }
                  ]
                },
                "option_types": {
                  "type": "array",
                  "items": { "enum": ["CE", "PE"] },
                  "minItems": 1,
                  "uniqueItems": true
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "underlying"],
          "properties": {
            "mode": { "const": "futures_of_underlying" },
            "underlying": { "$ref": "#/$defs/instrumentRef" },
            "futures": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "contract": { "enum": ["front_month", "next_month"], "default": "front_month" },
                "roll_days_before_expiry": { "type": "integer", "minimum": 0, "maximum": 10, "default": 1 }
              }
            }
          }
        },
        {
          "description": "E1 §3.3: dynamic Market-Movers stock-future universe — each day's tradable set is the top stock futures the market-data screener picks (resolved to front contracts at submission AND each live reload). No `underlying` — the radar is the server-side screener set.",
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": { "const": "futures_screener" },
            "side": { "enum": ["long", "short"], "default": "long" },
            "max_picks": { "type": "integer", "minimum": 1, "maximum": 20, "default": 5 },
            "source": {
              "enum": ["captured", "upstox"],
              "default": "captured",
              "description": "Screener radar: `captured` = the NIFTY-Bank snapshot subset (v1); `upstox` (E1 v2) = the full NIFTY-50 from on-demand Upstox daily candles."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": { "const": "minervini_funnel" },
            "bucket": {
              "enum": ["buyable", "buyable_on_deck"],
              "default": "buyable_on_deck",
              "description": "Which SEPA-funnel candidates the Phase-9 daily swing batch evaluates: immediately-buyable only, or buyable + on-deck (the VCP names about to cross their pivot). The batch drives the universe from the live funnel each session and applies this leaf per strategy at admission; the submission pin resolves the same leaf against the current funnel for display."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": { "const": "manas_arora_funnel" },
            "bucket": {
              "enum": ["buyable", "buyable_on_deck"],
              "default": "buyable_on_deck",
              "description": "Which Manas-Arora selection-funnel candidates the daily swing batch evaluates: immediately-buyable only, or buyable + on-deck (the base names about to cross their pivot). The batch drives the universe from the live funnel each session and applies this leaf per strategy at admission; the submission pin resolves the same leaf against the current funnel for display. Sibling of minervini_funnel."
            }
          }
        }
      ]
    },
    "universeFilters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min_avg_daily_volume": { "type": "number", "minimum": 0 },
        "min_price": { "type": "number", "minimum": 0 },
        "max_price": { "type": "number", "exclusiveMinimum": 0 },
        "exclude": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Z]+:.+$" },
          "uniqueItems": true
        }
      }
    },

    "timeframes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary"],
      "properties": {
        "primary": { "$ref": "#/$defs/interval" },
        "additional": {
          "type": "array",
          "items": { "$ref": "#/$defs/interval" },
          "uniqueItems": true,
          "maxItems": 5
        }
      }
    },

    "indicator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "alias", "timeframe"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "anyOf": [
            {
              "description": "ADVISORY known-name enum (editor autocomplete only - Q2/A5: unknown names are registry warnings at save, refusals at publish, NEVER schema violations)",
              "enum": ["EMA", "SMA", "RSI", "VWAP", "ADX", "MACD_HIST", "SUPERTREND", "SUPERTREND_LINE", "VOLUME_RATIO", "OI_CHANGE_PCT", "ATR", "VWMA", "PSAR", "ORB_HIGH", "ORB_LOW", "PREV_DAY_HIGH", "PREV_DAY_LOW", "PREV_DAY_CLOSE", "DAY_HIGH", "DAY_LOW", "GAP_PCT", "RS_VS_INDEX", "VIX_LEVEL", "BASIS_PCT", "ADVANCE_DECLINE_RATIO", "VCP_PIVOT", "WEEK52_HIGH", "WEEK52_LOW", "CHEAT_PIVOT", "THRUST"]
            },
            { "pattern": "^[A-Z][A-Z0-9_]*$" }
          ]
        },
        "alias": { "$ref": "#/$defs/identifier" },
        "timeframe": { "$ref": "#/$defs/interval" },
        "instrument": {
          "$ref": "#/$defs/instrumentRef",
          "description": "Optional context-series override (A7 [FP-19]): evaluate against this instrument's series instead of the signal instrument's; existence checked at publish against the instruments master"
        },
        "params": {
          "type": "object",
          "additionalProperties": {
            "type": ["number", "integer", "string", "boolean"]
          },
          "maxProperties": 12
        },
        "weight": { "type": "number", "minimum": 0, "default": 1.0 },
        "optional": { "type": "boolean", "default": false },
        "normalize": { "$ref": "#/$defs/normalize" }
      }
    },
    "normalize": {
      "description": "Maps the raw indicator value to a score s in [0,1] (A1 composite inputs)",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "from", "to"],
          "properties": {
            "type": { "const": "linear" },
            "from": { "type": "number" },
            "to": { "type": "number" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "bands"],
          "properties": {
            "type": { "const": "step" },
            "bands": {
              "type": "array",
              "minItems": 1,
              "maxItems": 10,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["score"],
                "properties": {
                  "upto": { "type": "number", "description": "Band applies while value <= upto; omit on the final catch-all band" },
                  "score": { "type": "number", "minimum": 0, "maximum": 1 }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": { "type": { "const": "direction" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": { "type": { "const": "rsi_momentum" } }
        }
      ]
    },

    "gateExpression": {
      "type": "string",
      "pattern": "^\\s*[a-z][a-z0-9_]*\\s*(>=|<=|==|!=|>|<)\\s*([a-z][a-z0-9_]*|-?[0-9]+(\\.[0-9]+)?)\\s*$",
      "description": "Threshold expression over aliases/built-ins (close, volume, vwap) - comparison operators only, NO arithmetic (closed grammar)"
    },
    "gateNode": {
      "oneOf": [
        { "$ref": "#/$defs/gateExpression" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["all"],
          "properties": {
            "all": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/gateNode" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["any"],
          "properties": {
            "any": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/gateNode" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["not"],
          "properties": { "not": { "$ref": "#/$defs/gateNode" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["crossover"],
          "properties": { "crossover": { "$ref": "#/$defs/crossPair" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["crossunder"],
          "properties": { "crossunder": { "$ref": "#/$defs/crossPair" } }
        }
      ]
    },
    "crossPair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fast", "slow"],
      "properties": {
        "fast": { "$ref": "#/$defs/identifier" },
        "slow": { "$ref": "#/$defs/identifier" }
      }
    },

    "entryRules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direction", "gate", "scoring"],
      "properties": {
        "direction": { "enum": ["long", "short", "both"] },
        "gate": { "$ref": "#/$defs/gateNode" },
        "scoring": {
          "type": "object",
          "additionalProperties": false,
          "required": ["threshold"],
          "properties": {
            "threshold": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
            "optional_min_score": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.6 },
            "optional_gate_margin": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.15 }
          }
        }
      }
    },

    "exitRule": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "params"],
          "properties": {
            "type": { "const": "stop_loss" },
            "params": { "$ref": "#/$defs/levelParams" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "params"],
          "properties": {
            "type": { "const": "take_profit" },
            "params": { "$ref": "#/$defs/levelParams" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "params"],
          "properties": {
            "type": { "const": "trailing_stop" },
            "params": {
              "type": "object",
              "additionalProperties": false,
              "required": ["basis"],
              "properties": {
                "basis": { "enum": ["premium_pct", "atr_multiple", "index_points", "indicator"], "description": "The trailing bases the engine actually evaluates. `percent` is deliberately absent: it is a LEVEL basis (stop_loss/take_profit) and was never evaluated as a trail, so declaring it bought a trailing stop that silently never fired. Use `premium_pct` for a percent-off-the-peak trail." },
                "value": { "type": "number", "exclusiveMinimum": 0 },
                "activate_at": { "type": "number", "exclusiveMinimum": 0 },
                "trail_by": { "type": "number", "exclusiveMinimum": 0 },
                "atr_period": { "type": "integer", "minimum": 1, "maximum": 200 },
                "arm_pct": { "type": "number", "exclusiveMinimum": 0, "maximum": 100, "description": "Manas §3.5B: an atr_multiple trail stays INERT until the favourable extreme is up arm_pct% off entry, then ratchets peak − value×ATR (monotone up). Absent → armed from entry (byte-identical to before)." },
                "atr_basis": { "enum": ["entry", "rolling"], "description": "H4: the atr_multiple trail's ATR basis — 'entry' (default; ATR pinned at the entry bar) or 'rolling' (the canonical Chandelier; ATR re-read at each bar, ratcheted off the highest-high). Absent → entry (byte-identical to before)." },
                "breakeven_floor": { "type": "boolean", "description": "H4: when true, an armed atr_multiple trail is never worse than the entry (cost basis) — the breakeven floor. Default false. Pairs with atr_basis:rolling for the Manas §3.5B Chandelier." },
                "alias": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
              },
              "anyOf": [
                { "required": ["value"] },
                { "required": ["activate_at", "trail_by"] },
                { "required": ["alias"] }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "params"],
          "properties": {
            "type": { "const": "time_stop" },
            "params": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "max_bars": { "type": "integer", "minimum": 1, "maximum": 10000 },
                "max_holding_days": { "type": "integer", "minimum": 1, "maximum": 365 }
              },
              "oneOf": [
                { "required": ["max_bars"], "not": { "required": ["max_holding_days"] } },
                { "required": ["max_holding_days"], "not": { "required": ["max_bars"] } }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "params"],
          "properties": {
            "type": { "const": "signal_exit" },
            "params": {
              "type": "object",
              "additionalProperties": false,
              "required": ["rule"],
              "properties": {
                "rule": {
                  "type": "string",
                  "pattern": "^\\s*((crossover|crossunder)\\(\\s*[a-z][a-z0-9_]*\\s*,\\s*[a-z][a-z0-9_]*\\s*\\)|[a-z][a-z0-9_]*\\s*(>=|<=|==|!=|>|<)\\s*([a-z][a-z0-9_]*|-?[0-9]+(\\.[0-9]+)?))\\s*$"
                },
                "min_volume": { "type": "number", "exclusiveMinimum": 0 }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "params"],
          "properties": {
            "type": { "const": "scaled_exit" },
            "params": {
              "type": "object",
              "additionalProperties": false,
              "required": ["tiers"],
              "properties": {
                "tiers": {
                  "description": "Sell-into-strength tiers (MV-7.4): close qty_pct of the ORIGINAL position when it is profit_pct in profit. Partial closes; the remainder keeps running under the stop / trail.",
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 8,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["profit_pct", "qty_pct"],
                    "properties": {
                      "profit_pct": { "type": "number", "exclusiveMinimum": 0 },
                      "qty_pct": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "params"],
          "properties": {
            "type": { "const": "square_off" },
            "params": {
              "description": "Manas §3.5C exhaustion square-off (whole-position exit). A too-fast clause (fast_pct + fast_bars) and/or a parabolic clause (parabolic_ma + parabolic_dist_pct); either fired clause exits. At least one COMPLETE clause is required.",
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "fast_pct": { "type": "number", "exclusiveMinimum": 0, "description": "Too-fast: exit when close >= close[fast_bars ago] * (1 + fast_pct%). Doc: ~30-50% in 2-4 days." },
                "fast_bars": { "type": "integer", "minimum": 1, "maximum": 100, "description": "Lookback (sessions) for the too-fast move." },
                "parabolic_ma": { "type": "integer", "minimum": 1, "maximum": 200, "description": "Short-MA period for the parabolic extension (doc default 10)." },
                "parabolic_dist_pct": { "type": "number", "exclusiveMinimum": 0, "description": "Parabolic: exit when close >= SMA(parabolic_ma) * (1 + parabolic_dist_pct%)." }
              },
              "anyOf": [
                { "required": ["fast_pct", "fast_bars"] },
                { "required": ["parabolic_ma", "parabolic_dist_pct"] }
              ]
            }
          }
        }
      ]
    },
    "levelParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basis", "value"],
      "properties": {
        "basis": {
          "enum": ["premium_pct", "percent", "atr_multiple", "r_multiple", "index_points"],
          "description": "Level basis for stop_loss/take_profit. NOTE: `percent` is REFUSED on options strategies (universe.mode = options_of_underlying) and validation returns 422. On the options plane `premium_pct` means percent of the OPTION PREMIUM while `percent` resolves against the INDEX entry price, so the name is the only thing distinguishing the two planes and an ambiguous one cannot be honoured. Use `premium_pct` for a premium-relative stop, or `index_points`/`atr_multiple` for an index-side one. On cash-equity strategies there is one plane, so `percent` is valid and unchanged."
        },
        "value": { "type": "number", "exclusiveMinimum": 0 },
        "atr_period": { "type": "integer", "minimum": 1, "maximum": 200 },
        "cap_pct": { "type": "number", "exclusiveMinimum": 0, "maximum": 100, "description": "Manas §3.5A: caps an atr_multiple stop DISTANCE at cap_pct% of entry (the tighter of value×ATR and the cap wins), so a wide-ATR stop never exceeds ~10%. Ignored by non-ATR bases." }
      }
    },

    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position_sizing", "max_positions", "session"],
      "properties": {
        "position_sizing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "params"],
          "properties": {
            "method": { "enum": ["fixed_quantity", "percent_equity", "premium_budget", "atr_risk", "kelly_fraction"] },
            "params": { "type": "object" }
          },
          "allOf": [
            {
              "if": { "properties": { "method": { "const": "fixed_quantity" } } },
              "then": {
                "properties": {
                  "params": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["quantity"],
                    "properties": { "quantity": { "type": "integer", "minimum": 1 } }
                  }
                }
              }
            },
            {
              "if": { "properties": { "method": { "const": "percent_equity" } } },
              "then": {
                "properties": {
                  "params": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["percent"],
                    "properties": { "percent": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 } }
                  }
                }
              }
            },
            {
              "if": { "properties": { "method": { "const": "premium_budget" } } },
              "then": {
                "properties": {
                  "params": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["budget_inr"],
                    "properties": {
                      "budget_inr": { "type": "number", "exclusiveMinimum": 0 },
                      "max_lots": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
                      "min_premium_inr": { "type": "number", "exclusiveMinimum": 0 }
                    }
                  }
                }
              }
            },
            {
              "if": { "properties": { "method": { "const": "atr_risk" } } },
              "then": {
                "properties": {
                  "params": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["risk_pct_equity"],
                    "properties": {
                      "risk_pct_equity": { "type": "number", "exclusiveMinimum": 0, "maximum": 10 },
                      "atr_period": { "type": "integer", "minimum": 1, "maximum": 200 }
                    }
                  }
                }
              }
            },
            {
              "if": { "properties": { "method": { "const": "kelly_fraction" } } },
              "then": {
                "properties": {
                  "params": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["fraction"],
                    "properties": {
                      "fraction": {
                        "type": "number",
                        "exclusiveMinimum": 0,
                        "maximum": 0.25,
                        "description": "HARD-CAPPED at 0.25 (plan v1 position-sizing table)"
                      },
                      "lookback_trades": { "type": "integer", "minimum": 10, "maximum": 1000 }
                    }
                  }
                }
              }
            }
          ]
        },
        "max_positions": { "type": "integer", "minimum": 1, "maximum": 100 },
        "max_positions_per_underlying": { "type": "integer", "minimum": 1, "maximum": 100 },
        "max_daily_loss_pct": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
        "session": {
          "type": "object",
          "additionalProperties": false,
          "required": ["style"],
          "properties": {
            "style": { "enum": ["intraday", "btst", "expiry_day", "positional", "swing"] },
            "window": { "$ref": "#/$defs/sessionWindow" },
            "square_off": { "$ref": "#/$defs/hhmm" },
            "allow_overnight": { "type": "boolean" },
            "expiry_day": {
              "type": "object",
              "additionalProperties": false,
              "required": ["allowed"],
              "properties": {
                "allowed": { "type": "boolean" },
                "window": { "$ref": "#/$defs/sessionWindow" }
              }
            },
            "pre_close_at": {
              "$ref": "#/$defs/hhmm",
              "description": "A7 [FP-6]: BTST pre-close evaluation clock (IST), default 15:20; evaluated against the deterministic pre-close bar view (A9)",
              "default": "15:20"
            },
            "fill_timing": {
              "enum": ["next_open", "at_close"],
              "description": "A7 [FP-6]: fill reference price; default at_close when style btst, else next_open"
            },
            "exit_intrabar": {
              "type": "boolean",
              "description": "A7 [FP-5]: evaluate SL/TP/trailing on each closed 1m bar in live AND replay (default true when primary > 1m); entry stays primary-bar-close"
            },
            "touch_basis": {
              "enum": ["bar_hl_worstof"],
              "description": "B3 / P1-10: opt-in CANDLE-path backtest exit-touch model. 'bar_hl_worstof' treats a protective stop/target as TOUCHED on the bar's HIGH/LOW (worst-of fill), catching intrabar spikes a close-basis exit misses. Absent = the byte-identical close-basis default; the premium replay path ignores it."
            }
          }
        }
      }
    },
    "sessionWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": { "$ref": "#/$defs/hhmm" },
        "to": { "$ref": "#/$defs/hhmm" }
      }
    },

    "backtest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaults": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "interval": { "$ref": "#/$defs/interval" },
            "lookback_days": { "type": "integer", "minimum": 1, "maximum": 3650 },
            "initial_capital": { "type": "number", "exclusiveMinimum": 0 },
            "benchmark": { "type": "string", "pattern": "^[A-Z]+:.+$", "default": "NSE:NIFTY 50" },
            "costs": { "$ref": "#/$defs/costs" }
          }
        },
        "relax_session": {
          "type": "boolean",
          "default": false,
          "description": "Backtest-only (options path): when true the intraday session ENTRY clock rail (window / square_off / expiry-day entry restriction) is disabled so a strategy fires its signal-driven entries across the FULL series — a functional-smoke lever for a strategy whose intraday clock would otherwise thin the trade list. It does NOT relax the signal gate or indicator warmup (those would manufacture fake trades). Off by default; the engine goldens are byte-identical."
        },
        "oi_confluence_gate": {
          "type": "object",
          "additionalProperties": false,
          "description": "Backtest-only OI-confluence entry gate: drop option legs whose entry fires against the historical Connecting-Dots trend (long/CE into Bearish, short/PE into Bullish). Opt-in; off by default so existing replays are unaffected.",
          "properties": {
            "enabled": { "type": "boolean", "default": false },
            "iv": { "type": "boolean", "default": false, "description": "Backtest-only (#4): the sibling IV-confluence filter — drop a long/CE leg entered when the active-strike IV factor reads Bearish (or short/PE when Bullish), reusing the same Connecting-Dots read. NEUTRAL on derived history, so a forward-paper discriminator. Off by default; independent of 'enabled'." },
            "interval": { "type": "string", "default": "5m", "description": "OI interval the confluence is read at (e.g. 5m)." },
            "index": { "type": "string", "description": "Optional (2b-E2): the index whose OI confluence gates entries. Defaults to the options-execution root (universe.underlying); set it to gate a decoupled signal/option pair on the signal-driver's OI (e.g. a SENSEX-option strategy gating on 'NIFTY 50')." }
          }
        },
        "optimize": {
          "type": "object",
          "additionalProperties": false,
          "required": ["parameters", "method", "max_trials", "objective"],
          "properties": {
            "parameters": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "items": { "$ref": "#/$defs/optimizeParameter" }
            },
            "method": { "enum": ["grid", "random", "tpe", "nsga2"] },
            "max_trials": { "type": "integer", "minimum": 1, "maximum": 100000 },
            "objective": {
              "oneOf": [
                { "$ref": "#/$defs/objective" },
                { "type": "array", "minItems": 1, "maxItems": 4, "items": { "$ref": "#/$defs/objectiveEntry" } }
              ]
            },
            "constraints": {
              "type": "object",
              "additionalProperties": false,
              "properties": { "min_trades": { "type": "integer", "minimum": 1 } }
            },
            "walk_forward": {
              "type": "object",
              "additionalProperties": false,
              "required": ["train_days", "test_days", "step_days"],
              "description": "Freeze-time obligation (BPC); consumer lands Stage D Phase 31",
              "properties": {
                "train_days": { "type": "integer", "minimum": 1, "maximum": 3650 },
                "test_days": { "type": "integer", "minimum": 1, "maximum": 3650 },
                "step_days": { "type": "integer", "minimum": 1, "maximum": 3650 },
                "anchored": { "type": "boolean", "default": false }
              }
            }
          }
        }
      }
    },
    "scalper": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional per-strategy scalper overrides (read by ScalperConfig.from). Absent ⇒ the built-in gate defaults, byte-identical. §5 (100%-YAML): future scalper config grows here.",
      "properties": {
        "params": {
          "type": "object",
          "additionalProperties": false,
          "description": "Per-strategy overrides for the ARMABLE confluence-gate thresholds; each optional, absent ⇒ the ScalperGates default constant. Tuning an armed gate is YAML-only, no Java change. Scales: vwap_distance_*/indicator_distance_max_pct are PRICE FRACTIONS (0.004 = 0.4%); iv_buyer_cap is a 0..1 IV FRACTION (0.40 = '40 IV'); oi_divergence_min_pct/price_impulse_min_pct are PERCENTAGES (20 = 20%); gap_suppress_pts is index POINTS.",
          "properties": {
            "vwap_distance_min_frac": { "type": "number", "minimum": 0, "maximum": 1, "description": "vwap-distance gate: min |close-vwap|/close (0 = off, the VWAP-pin sit-out lower clause)." },
            "vwap_distance_max_frac": { "type": "number", "exclusiveMinimum": 0, "maximum": 1, "description": "vwap-distance gate: max |close-vwap|/close pullback band (default 0.004)." },
            "gap_suppress_pts": { "type": "number", "exclusiveMinimum": 0, "description": "gap-size-side-gate: index-point gap-down that suppresses the PE side (default 300)." },
            "indicator_distance_max_pct": { "type": "number", "exclusiveMinimum": 0, "maximum": 1, "description": "indicator-distance-veto: max nearest-indicator distance fraction (default 0.015)." },
            "oi_divergence_min_pct": { "type": "number", "minimum": 0, "maximum": 100, "description": "oi-divergence-magnitude: min signed PE-CE OI gap as percent of total (default 20)." },
            "price_impulse_min_pct": { "type": "number", "minimum": 0, "maximum": 100, "description": "oi-divergence-magnitude: corroborating price-impulse percent (default 50)." },
            "iv_buyer_cap": { "type": "number", "exclusiveMinimum": 0, "maximum": 1, "description": "iv-buyer-cap: side IV fraction above which a long-premium buy is too rich (default 0.40)." },
            "no_trade_before": { "type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]$", "description": "§0B time rail: no entry before this IST HH:mm (default 09:45)." },
            "no_fresh_entry_after": { "type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]$", "description": "§0B time rail: no fresh entry at/after this IST HH:mm (default 15:30)." },
            "midday_block": { "type": "boolean", "default": true, "description": "§0B time rail toggle: when false, trade THROUGH the 11:00-13:00 sideways window (default true = blocked)." },
            "volume_floor": { "type": "number", "exclusiveMinimum": 0, "description": "§0B volume rail: per-strategy bar-volume floor override (default = the per-index map — NIFTY 125000 / others 50000)." }
          }
        }
      }
    },
    "costs": {
      "type": "object",
      "additionalProperties": false,
      "description": "Q1/A5: slippage_ticks XOR slippage_bps (at most one); fees{} is the optional statutory schedule, defaulted from the current Zerodha/NSE schedule when omitted (values pinned Stage D)",
      "not": { "required": ["slippage_ticks", "slippage_bps"] },
      "properties": {
        "per_lot_inr": { "type": "number", "minimum": 0 },
        "pct_per_side": { "type": "number", "minimum": 0, "maximum": 5 },
        "slippage_ticks": { "type": "integer", "minimum": 0, "maximum": 100 },
        "slippage_bps": { "type": "number", "minimum": 0, "maximum": 1000 },
        "fees": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "stt": { "type": "number", "minimum": 0, "maximum": 5 },
            "exchange_txn": { "type": "number", "minimum": 0, "maximum": 5 },
            "gst": { "type": "number", "minimum": 0, "maximum": 50 },
            "stamp": { "type": "number", "minimum": 0, "maximum": 5 },
            "sebi": { "type": "number", "minimum": 0, "maximum": 5 }
          }
        }
      }
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "direction"],
      "properties": {
        "metric": { "$ref": "#/$defs/identifier" },
        "direction": { "enum": ["maximize", "minimize"] },
        "fold_aggregation": {
          "enum": ["mean", "min", "mean_minus_std"],
          "description": "Freeze-time obligation (S1A); consumer lands Stage D Phase 32"
        }
      }
    },
    "objectiveEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "direction"],
      "properties": {
        "metric": { "$ref": "#/$defs/identifier" },
        "direction": { "enum": ["maximize", "minimize"] }
      }
    },
    "optimizeParameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(indicators\\[(alias=[a-z][a-z0-9_]*|type=[a-z][a-z0-9_]*|[0-9]+)\\]\\.params\\.[a-z][a-z0-9_]*|exit_rules\\[(alias=[a-z][a-z0-9_]*|type=[a-z][a-z0-9_]*|[0-9]+)\\]\\.params\\.[a-z][a-z0-9_]*|entry_rules\\.scoring\\.[a-z][a-z0-9_]*|risk\\.position_sizing\\.[a-z][a-z0-9_]*|entry_rules\\.gate\\.[a-z][a-z0-9_]*|risk\\.(max_positions_per_underlying|max_positions))$",
          "description": "Closed whitelist grammar (COMMON 12.5, EVO row 21): alias/type selectors preferred; bare positional indices accepted but linted. entry_rules.gate.<lhs> tunes a gate comparison's numeric literal; risk.max_positions[_per_underlying] tunes a position cap"
        },
        "range": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2
        },
        "choices": {
          "type": "array",
          "minItems": 2,
          "maxItems": 50,
          "items": { "type": ["number", "string", "boolean"] }
        },
        "step": { "type": "number", "exclusiveMinimum": 0 }
      },
      "oneOf": [
        { "required": ["range"], "not": { "required": ["choices"] } },
        { "required": ["choices"], "not": { "required": ["range"] } }
      ]
    }
  }
}
