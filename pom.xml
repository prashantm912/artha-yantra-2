<?xml version="1.0" encoding="UTF-8"?>
<!-- ArthaYantra 2.0 — root Maven reactor (A.3 / Phase 4).
     Boot 3.5.x parent BOM, Java 21; modules grow per phase (COMMON §6). -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.15</version>
    <relativePath/>
  </parent>

  <groupId>in.arthayantra</groupId>
  <artifactId>arthayantra-parent</artifactId>
  <version>2.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>ArthaYantra 2.0 — reactor</name>

  <modules>
    <module>libs/common-web</module>
    <module>libs/market-calendar</module>
    <module>libs/strategy-schema</module>
    <module>libs/strategy-engine</module>
    <module>libs/black76-math</module>
    <module>services/edge-gateway</module>
    <module>services/market-data-service</module>
    <module>services/strategy-signal-service</module>
    <module>services/backtest-service</module>
    <module>tools/hash-password</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <!-- -Dtest patterns must skip reactor modules with no matching tests so the documented
         Phase-14 S1 command (-am test -Dtest='*Black76*') runs verbatim -->
    <surefire.failIfNoSpecifiedTests>false</surefire.failIfNoSpecifiedTests>
    <error-prone.version>2.50.0</error-prone.version>
    <checkstyle.version>13.5.0</checkstyle.version>
    <maven-checkstyle-plugin.version>3.6.0</maven-checkstyle-plugin.version>
    <bouncycastle.version>1.84</bouncycastle.version>
    <jacoco.version>0.8.13</jacoco.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Argon2id (A.2.3) — not managed by the Boot BOM -->
      <dependency>
        <groupId>org.bouncycastle</groupId>
        <artifactId>bcprov-jdk18on</artifactId>
        <version>${bouncycastle.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <!-- service modules opt in (A.10: Java services >= 60% line) -->
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>${jacoco.version}</version>
          <executions>
            <execution>
              <id>jacoco-agent</id>
              <goals>
                <goal>prepare-agent</goal>
              </goals>
            </execution>
            <execution>
              <id>jacoco-report</id>
              <phase>verify</phase>
              <goals>
                <goal>report</goal>
              </goals>
            </execution>
            <execution>
              <id>jacoco-check</id>
              <phase>verify</phase>
              <goals>
                <goal>check</goal>
              </goals>
              <configuration>
                <rules>
                  <rule>
                    <element>BUNDLE</element>
                    <limits>
                      <limit>
                        <counter>LINE</counter>
                        <value>COVEREDRATIO</value>
                        <minimum>0.60</minimum>
                      </limit>
                    </limits>
                  </rule>
                </rules>
              </configuration>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-checkstyle-plugin</artifactId>
          <version>${maven-checkstyle-plugin.version}</version>
          <dependencies>
            <dependency>
              <groupId>com.puppycrawl.tools</groupId>
              <artifactId>checkstyle</artifactId>
              <version>${checkstyle.version}</version>
            </dependency>
          </dependencies>
          <configuration>
            <!-- Google style at 120 columns (Phase 4); config/checkstyle/checkstyle.xml
                 is google_checks.xml for checkstyle ${checkstyle.version} with only
                 the LineLength max patched 100 -> 120 -->
            <configLocation>${maven.multiModuleProjectDirectory}/config/checkstyle/checkstyle.xml</configLocation>
            <consoleOutput>true</consoleOutput>
            <includeTestSourceDirectory>true</includeTestSourceDirectory>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <!-- Error Prone (Phase 4); the required jdk.compiler add-exports live
               in .mvn/jvm.config -->
          <compilerArgs>
            <arg>-XDcompilePolicy=simple</arg>
            <arg>-XDaddTypeAnnotationsToSymbol=true</arg>
            <arg>--should-stop=ifError=FLOW</arg>
            <arg>-Xplugin:ErrorProne</arg>
          </compilerArgs>
          <annotationProcessorPaths>
            <path>
              <groupId>com.google.errorprone</groupId>
              <artifactId>error_prone_core</artifactId>
              <version>${error-prone.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
        <executions>
          <execution>
            <id>checkstyle-validate</id>
            <phase>validate</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <!-- STRUCTURAL tests must never be rerun-eligible (2026-07-29). CI runs the whole reactor
             with `-Dsurefire.rerunFailingTestsCount=2` so the Testcontainers/awaitility ITs can
             survive a 2-core timeout, and that step's comment claimed a "genuinely failing test
             still fails after the retries". That is FALSE for ApplicationModules.verify(): on main
             run 30465321004 `marketdata.ModularityTest.modulesVerify` failed on Run 1 with a real
             cycle (bhavcopy -> nse -> screener -> bhavcopy), passed on the retry, and was filed
             under `[WARNING] Flakes:` — the shard reported SUCCESS with a live architecture
             violation on main. (It retries green because Spring Modulith caches the computed
             ApplicationModules, so the second attempt does not recompute the verdict.) The same
             violation reproduces DETERMINISTICALLY on a clean local build, and PR #1114 went red on
             it — so whether any given PR sees an architecture regression was luck.

             A structural check is deterministic by construction and can never be legitimately
             flaky, so it gets its own execution pinned to zero retries.

             ⚠️ SCOPE, measured 2026-07-30 (task_fbc8e4bd) — do NOT widen this list reflexively.
             The masking is NOT a property of "structural tests" in general; it is a property of
             Spring Modulith's STATIC CACHE of the computed ApplicationModules, which makes the
             retry skip recomputation. Tests that re-derive their verdict every run cannot be
             masked, and adding them here is config for an impossible case.
             VERIFIED by breaking MapReturnRatchetTest's floor and running it with
             -Dsurefire.rerunFailingTestsCount=2 WITHOUT the exemption: it ran 3 times, failed all
             3, and the build FAILED with no `Flakes:` marker. Same reasoning covers
             GatewayRouteAllowlistTest (pure file scan) and ContractCaptureTest (recomputes the
             spec each run, and its Spring context is a LEGITIMATE flake source, so exempting it
             would convert infrastructure noise into hard failures).
             Before adding a test here, ask: does it CACHE its verdict across runs in one JVM? The POM's explicit value
             wins over the `-D` user property, which only supplies a default. Split so the two
             cannot drift: the default execution EXCLUDES these, the pinned one INCLUDES them, and
             the same pattern list drives both. -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <executions>
          <execution>
            <id>default-test</id>
            <configuration>
              <excludes>
                <exclude>**/ModularityTest.java</exclude>
              </excludes>
            </configuration>
          </execution>
          <execution>
            <id>structural-tests-no-rerun</id>
            <phase>test</phase>
            <goals>
              <goal>test</goal>
            </goals>
            <configuration>
              <rerunFailingTestsCount>0</rerunFailingTestsCount>
              <includes>
                <include>**/ModularityTest.java</include>
              </includes>
              <!-- a module with no ModularityTest (libs, and any service that has not added one)
                   must not fail this execution for having nothing to run -->
              <failIfNoSpecifiedTests>false</failIfNoSpecifiedTests>
              <failIfNoTests>false</failIfNoTests>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <!-- H9 stale-jar guard: bake the git sha into every jar (git.properties) so a
             running service reveals the exact commit it was built from at /actuator/info,
             and a stale-jar deploy (the mutable :dev tag trap) is mechanically detectable
             via `ay verify-deploy`. Version managed by spring-boot-starter-parent. Never
             fails the build when .git is absent (source tarball / detached build). -->
        <groupId>io.github.git-commit-id</groupId>
        <artifactId>git-commit-id-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>get-the-git-infos</id>
            <phase>initialize</phase>
            <goals>
              <goal>revision</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <failOnNoGitDirectory>false</failOnNoGitDirectory>
          <failOnUnableToExtractRepoInfo>false</failOnUnableToExtractRepoInfo>
          <generateGitPropertiesFile>true</generateGitPropertiesFile>
          <includeOnlyProperties>
            <property>git.branch</property>
            <property>git.commit.id</property>
            <property>git.commit.id.abbrev</property>
            <property>git.commit.time</property>
          </includeOnlyProperties>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
