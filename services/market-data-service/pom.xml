<?xml version="1.0" encoding="UTF-8"?>
<!-- market-data-service (A.7a / Phase 7): Spring Modulith skeleton with the
     five Kite ports and the deterministic mock tick feed ??? the
     credential-free substrate every later phase runs on (D13). -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>in.arthayantra</groupId>
    <artifactId>arthayantra-parent</artifactId>
    <version>2.0.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>market-data-service</artifactId>
  <name>market-data-service</name>

  <properties>
    <spring-modulith.version>1.4.12</spring-modulith.version>
    <resilience4j.version>2.3.0</resilience4j.version>
    <kiteconnect.version>3.5.1</kiteconnect.version>
    <wiremock.version>3.13.2</wiremock.version>
    <commons-math3.version>3.6.1</commons-math3.version>
    <protobuf.version>4.33.2</protobuf.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.modulith</groupId>
        <artifactId>spring-modulith-bom</artifactId>
        <version>${spring-modulith.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- COMMON ??3 stack pin: javakiteconnect's bundled Gson excluded,
           Gson 2.13.2 pinned -->
      <dependency>
        <groupId>com.google.code.gson</groupId>
        <artifactId>gson</artifactId>
        <version>2.13.2</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>in.arthayantra</groupId>
      <artifactId>common-web-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>in.arthayantra</groupId>
      <artifactId>common-web-servlet</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>in.arthayantra</groupId>
      <artifactId>market-calendar</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- M7 (#128 swing exit-parity slice 1): test-scope only, so the frozen live ExitEvaluator
         can drive the swing exit-equivalence characterization fixture directly, without needing
         the strategy-signal-service module or a Spring context. Production code in this service
         is untouched — the deep sims keep their own hand-rolled exit logic. -->
    <dependency>
      <groupId>in.arthayantra</groupId>
      <artifactId>strategy-engine</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-cache</artifactId>
    </dependency>
    <dependency>
      <groupId>com.github.ben-manes.caffeine</groupId>
      <artifactId>caffeine</artifactId>
    </dependency>
    <!-- B-3: the ONE resilience dependency (limiters + retry + breakers) -->
    <dependency>
      <groupId>io.github.resilience4j</groupId>
      <artifactId>resilience4j-spring-boot3</artifactId>
      <version>${resilience4j.version}</version>
    </dependency>
    <!-- live KiteTicker WS adapter (B-6); REST live impls speak the Kite wire
         format via RestClient so WireMock can verify them (the SDK pins its
         base URL, making the per-phase WireMock acceptance criteria
         unsatisfiable through it) -->
    <dependency>
      <groupId>com.zerodhatech.kiteconnect</groupId>
      <artifactId>kiteconnect</artifactId>
      <version>${kiteconnect.version}</version>
      <exclusions>
        <exclusion>
          <groupId>com.google.code.gson</groupId>
          <artifactId>gson</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
    </dependency>
    <!-- Upstox v3 market-data-feed frames are binary protobuf (MarketDataFeedV3 /
         FeedResponse). We decode them with protobuf-java's low-level CodedInputStream
         (Wave U3) — no protoc / no generated classes / no new build plugin (protoc
         download is fragile on the TLS-intercepting-AV box). The WS transport reuses
         nv-websocket-client, already on the classpath transitively via kiteconnect. -->
    <dependency>
      <groupId>com.google.protobuf</groupId>
      <artifactId>protobuf-java</artifactId>
      <version>${protobuf.version}</version>
    </dependency>
    <!-- Black-76 pricing/IV math hoisted to libs/black76-math (Phase 30A / A10);
         commons-math3 (normal CDF) arrives transitively through it -->
    <dependency>
      <groupId>in.arthayantra</groupId>
      <artifactId>black76-math</artifactId>
      <version>${project.version}</version>
    </dependency>
        <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
      <version>2.8.9</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-starter-core</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- ITs apply the real deploy/flyway lineages against the pinned
         Timescale container (runtime migrations stay with flyway-init, D17) -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- live-impl wire tests (B-6: WireMock 3.x stubs the Kite HTTP API) -->
    <dependency>
      <groupId>org.wiremock</groupId>
      <artifactId>wiremock-standalone</artifactId>
      <version>${wiremock.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>market-data-service</finalName>
    <plugins>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
          <execution>
            <!-- H9 stale-jar guard: bake build.time/version into build-info.properties so
                 /actuator/info reveals when this jar was built (pairs with git.properties). -->
            <id>build-info</id>
            <goals>
              <goal>build-info</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
