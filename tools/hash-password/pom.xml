<?xml version="1.0" encoding="UTF-8"?>
<!-- tools/hash-password (CD-13 / A.2.7): tiny Java main emitting an Argon2id
     PHC string for ARTHA_OWNER_PASSWORD_HASH.
     Usage: .\mvnw.cmd -pl tools/hash-password -am -q exec:java "-Dexec.args=<password>" -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>in.arthayantra</groupId>
    <artifactId>arthayantra-parent</artifactId>
    <version>2.0.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>hash-password</artifactId>
  <name>tools — hash-password</name>

  <dependencies>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-crypto</artifactId>
    </dependency>
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcprov-jdk18on</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-nop</artifactId>
    </dependency>
    <!-- spring-security-crypto logs via commons-logging -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-jcl</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <configuration>
          <mainClass>in.arthayantra.tools.HashPassword</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
